# Copy to .env.local for local development, and add the same keys in Vercel → Settings → Environment Variables.

# Public URL of the website (used for canonical links, sitemap and share images)
NEXT_PUBLIC_SITE_URL=https://betribilar.is

# true  = sales demo: "til staðfestingar" markers, photo placeholders captioned, hidden from search engines
# false = published site
NEXT_PUBLIC_DEMO_MODE=true

# Appointment-request form delivery via Resend (https://resend.com, free tier is enough).
# Without RESEND_API_KEY the form tells visitors plainly that nothing was sent.
RESEND_API_KEY=
# Where requests are delivered (defaults to betribilar@simnet.is)
CONTACT_TO_EMAIL=betribilar@simnet.is
# Sender — must be on a domain verified in Resend, e.g. "Vefsíða Betri Bíla <vefur@betribilar.is>"
CONTACT_FROM_EMAIL=
